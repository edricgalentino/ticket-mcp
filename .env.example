# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.

# Where the SQLite database lives, relative to the project root.
DATABASE_FILE=ticket-mcp.db

# Signs the browser session cookie. Generate your own:
#   openssl rand -base64 32
SESSION_SECRET=

# The bearer token an MCP client presents. Scaffolding, per ADR 0001 -- it is
# swapped for OAuth behind resolvePrincipal. Generate your own:
#   openssl rand -hex 32
MCP_BEARER_TOKEN=

# The seeded Agent this token resolves to (see ADR 0002).
MCP_AGENT_EMAIL=agent@ticket-mcp.local
